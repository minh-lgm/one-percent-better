# All variables are optional; the app runs with defaults when no .env exists.
# Copy to `.env.local` (git-ignored) to enable the optional Google sign-in / cloud sync.

# Name of the IndexedDB database (default: one-percent-better)
VITE_DB_NAME=one-percent-better

# How often the open app checks whether the daily reminder is due, in ms (1000–3600000; default 60000).
VITE_REMINDER_CHECK_INTERVAL_MS=60000

# Vite `base` when hosting under a sub-path (read at build time only; default /)
# BASE_PATH=/one-percent-better/

# ---- Cloud (optional, phase 2). Leave empty to build the app without any account feature. ----
# Supabase Project URL (Project Settings → API). Only https://… is accepted (http://localhost / http://127.0.0.1 for local testing).
VITE_SUPABASE_URL=
# Supabase publishable key (`sb_publishable_…`). Public by design; Row Level Security protects the data.
# NEVER put a secret (service-role) key here: every VITE_* value ends up in the JavaScript bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Fallback for projects that still use the legacy anon JWT; only read when the publishable key is empty.
VITE_SUPABASE_ANON_KEY=
# Background sync period while the app is visible, in ms (60000–3600000; default 300000). Used from M7.
VITE_SYNC_INTERVAL_MS=300000

# ---- Native sign-in (iOS app, from M14). Public client identifiers from Google Cloud (TASKS U21); leave empty until then. ----
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=
# NEVER put Apple / App Store Connect keys, certificates or passwords in any VITE_* variable or in this file:
# they live only in GitHub Actions secrets (README "iOS release") and Supabase Edge Function secrets.

# ---- Only for `npm run test:db` (Supabase local on Docker; values printed by `npx supabase status`) ----
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_PUBLISHABLE_KEY=
# SUPABASE_TEST_SECRET_KEY=
