# All variables are optional; the app runs with defaults when no .env exists.

# Name of the IndexedDB database (default: one-percent-better)
VITE_DB_NAME=one-percent-better

# How often the open app checks whether the daily reminder is due, in ms (1000–3600000; default 60000).
VITE_REMINDER_CHECK_INTERVAL_MS=60000

# Vite `base` when hosting under a sub-path (read at build time only; default /)
# BASE_PATH=/1percent-better/
