{
  "name": "one-percent-better",
  "private": true,
  "version": "0.1.0",
  "description": "1% Better per Day — local-first PWA for tracking daily goal time",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "e2e:install": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "icons": "node scripts/gen-icons.mjs",
    "fixtures:large": "node scripts/gen-large-backup.mjs",
    "bench": "cross-env BENCH_ASSERT=1 vitest run src/services/stats-service.test.ts --reporter=verbose"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "dexie": "4.4.6",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-is": "19.3.0",
    "react-router": "7.18.4",
    "recharts": "3.10.1",
    "workbox-precaching": "7.4.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "cross-env": "10.1.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.11",
    "workbox-build": "7.4.1"
  }
}
