# Vite mode `cloud-e2e` (npm run build:cloud-e2e): points the app at the local mock Supabase
# (e2e/mock-supabase/server.mjs). These are NOT secrets: the key is a fake accepted only by the mock.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_mock
VITE_SUPABASE_ANON_KEY=
VITE_SYNC_INTERVAL_MS=300000
